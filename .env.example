# Copie para .env e preencha. Todas as variáveis são opcionais para rodar localmente.

# Chave da API ipgeolocation.io (consulta de cidade)
VITE_IPGEOLOCATION_KEY=

# URL pública do site, sem barra final (usada nas pré-visualizações de link)
VITE_SITE_URL=

# Servidor TURN (ajuda quando um dos lados está atrás de NAT restritivo)
VITE_TURN_URLS=
VITE_TURN_USER=
VITE_TURN_PASS=
